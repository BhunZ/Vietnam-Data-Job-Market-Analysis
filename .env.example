# Copy to .env and fill in real values. NEVER commit .env.
#
# Write `NAME=value` with no spaces around the `=`. python-dotenv tolerates `NAME =value`;
# `docker run --env-file` and `docker compose` reject the whole file over it, with an error
# that names one variable and not the rule it broke.
#
# Nothing here is required to run the pipeline against Bronze that already exists. Scraping
# needs ScraperAPI, labelling needs at least one judge, and sync needs R2 — each part reports
# clearly when its keys are absent instead of failing later.

# ── Scraping ────────────────────────────────────────────────────────────────
# https://www.scraperapi.com/ — free tier is 1,000 requests/month per key. Every fetch goes
# through this, which is why the weekly GitHub Actions run is not blocked by the job boards:
# the origin address is ScraperAPI's proxy pool, not the runner's. A run costs roughly 400
# requests, and `pipeline scrape` refuses to start when the remaining budget cannot cover one.
# The secondary key is rotation and headroom.
SCRAPER_API_KEY=
SCRAPER_API_KEY_SECONDARY=

# ── Object storage (Cloudflare R2, S3-compatible) ────────────────────────────
# Bronze snapshots are the only record of what a board showed on a given day; once a posting is
# taken down no re-scrape recovers it. Mirroring them off this machine is what makes the
# warehouse rebuildable. Leave these empty and everything still works — only `pipeline sync`
# stops, and it says so.
#
# R2_BUCKET is easy to miss: Cloudflare shows an S3 endpoint with the bucket appended, so the
# name is the last path segment of that URL. The endpoint itself is derived from the account id
# and is not a separate setting.
#
# The API token must be **Object Read & Write**. A read-only token lists a bucket perfectly
# well, so everything looks healthy until the first upload — run `pipeline sync check`, which
# writes, reads back and deletes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── LLM judges for the labeling engine (job_family_engine/) ─────────────────
# A judge is built only when its key is present, so this list is what decides the judge pool.
# Independent model FAMILIES are chosen on purpose: an arbiter that shares a lab with one of
# the sides it is breaking a tie between is not independent.
# (Groq-Llama is the SAME model as Cerebras-Llama → kept only as a fallback.)
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=

# Cloudflare Workers AI. The OpenAI-compatible base_url embeds the account id, so both are
# needed. Separate from the R2 credentials above even though both are Cloudflare.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 9Router: a local proxy exposing many free providers behind one OpenAI-compatible endpoint.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
