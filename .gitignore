# Secrets
.env

# Data artifacts (raw/bronze/labeling/dataset) and DBs — EXCEPT the shipped warehouse below
/data/*
*.duckdb
*.duckdb.wal
# Ship the warehouse (jobs_silver + job_family + gold_* + raw jobs) so the analysis teammate (Luồng B)
# can work straight from the DB without rebuilding the whole pipeline.
!/data/warehouse.duckdb

# Ship the three small collaboration artifacts too. Each is a task someone can pick up, and each is
# referenced by name in the docs — a doc that points at an ignored file is a dead end for a teammate.
# NOTE the re-ignore line inside each directory: un-ignoring the DIRECTORY alone would also un-ignore
# `llm_cache/` (3,694 vote JSONs) and the label parquets, which must stay out of the repo.
!/data/labeling/
/data/labeling/*
!/data/labeling/spot_check.csv
!/data/labeling/company_industry_todo.csv
!/data/quality/
/data/quality/*
!/data/quality/unmapped_skills.csv

# Generated artifacts. The committed figures are the PNGs; the interactive HTML twin is a local
# convenience only, and the two KPI/quality docs are regenerated by the CLI — none of them are worth
# a diff on every run.
analysis/figures/*.html
docs/labeling_kpi.md
docs/quality_report.md
# The Phase-2 taxonomy PROPOSAL. Superseded by the live one at
# job_family_engine/taxonomy/taxonomy_v1.yml, which is what the engine actually loads. Shipping both
# under the same filename only makes a reader guess which one is real; regenerate with
# `python -m pipeline.dataset.run` if you want to see the proposal again.
ref/taxonomy/

# Recon scratch
_recon/

# Claude Code local config (personal tooling, not part of the project)
.claude/
.env.*
!.env.example

